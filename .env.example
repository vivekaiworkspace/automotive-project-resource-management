# ==============================================================================
# Automotive Project & Resource Management System
# Core Pilot Foundation - Environment Variables Template
#
# Usage:
#   Copy this template to .env for local Docker Compose or bare-metal execution:
#   Windows (PowerShell): Copy-Item .env.example .env
#   Linux/macOS:          cp .env.example .env
#
# SECURITY NOTICE:
#   Never commit real credentials or secrets to version control.
# ==============================================================================

# --- Application Runtime ---
NODE_ENV=development
APP_NAME=Automotive-RPM-Core-Pilot
APP_PORT=3000
APP_HOST=0.0.0.0
APP_TIMEZONE=Asia/Kolkata

# --- Container Host Port Bindings ---
BACKEND_PORT=3000
FRONTEND_PORT=8080
DB_PORT=5432

# --- PostgreSQL Database Credentials (CPD-010) ---
DB_HOST=db
DB_PORT=5432
DB_NAME=automotive_rpm
DB_USER=rpm_app
DB_PASSWORD=rpm_secure_dev_password_2026!
DB_SSL=false
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT_MS=30000

# --- Session & Encryption Secrets (Min 32 characters) ---
SESSION_SECRET=change_me_to_a_secure_random_key_with_at_least_32_characters_for_prod!
COOKIE_SECURE=false

# --- First-Run Administrative Bootstrap (CPD-010) ---
ADMIN_EMAIL=admin.pilot@ems-ecu.internal
ADMIN_INITIAL_PASSWORD=InitialAdminPass_MustChangeOnFirstLogin123!

# --- Diagnostic & Logging ---
LOG_LEVEL=info
